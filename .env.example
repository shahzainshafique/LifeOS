# Copy to .env.local and fill in the two Supabase keys that `npx supabase start`
# prints (PUBLISHABLE_KEY and SECRET_KEY). Everything else works as-is for a
# standard local setup. Real secrets never belong in this file — it's a template.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (URLs are the local defaults; keys come from `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable key from `supabase start`>
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<secret key from `supabase start`>

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_CHAT_MODEL=qwen2.5:7b-instruct
LLM_EXTRACT_MODEL=qwen2.5:7b-instruct
LLM_EMBED_MODEL=nomic-embed-text
LLM_EMBED_DIM=768

# Cloud escape hatch — OFF by default. Nothing leaves the machine unless this is true.
CLOUD_LLM_ENABLED=false
ANTHROPIC_API_KEY=

# Background jobs (pg-boss connects straight to the local Postgres)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
